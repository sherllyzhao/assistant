# MongoDB Atlas 后台配置
PORT=8787
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sherlly?retryWrites=true&w=majority
MONGODB_DB=sherlly
MONGODB_COLLECTION=appData
MONGODB_USERS_COLLECTION=users
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
SHERLLY_SESSION_TTL_DAYS=30
SHERLLY_API_TOKEN=change-me-to-a-long-random-token
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=localhost
CORS_ORIGIN=http://127.0.0.1:5188
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Google Calendar OAuth：client ID 可作为 Worker var；其余敏感值必须使用 Worker Secret。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/integrations/google/callback
GOOGLE_OAUTH_SUCCESS_URL=http://127.0.0.1:5188/
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_TOKEN_KEY=

# 前端云同步配置：不填则继续使用本地 Electron JSON / localStorage。
# 配置 VITE_SHERLLY_API_URL 后，打开应用会先登录/注册账号，再按账号同步云端数据。
VITE_SHERLLY_API_URL=http://127.0.0.1:8787
VITE_SHERLLY_API_TOKEN=change-me-to-a-long-random-token
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 桌面安装包远程页面配置：用于“页面更新不重新发 exe”的模式。
# exe 会优先加载这个线上前端页面；页面自身再通过 VITE_SHERLLY_API_URL 连接后台。
SHERLLY_RENDERER_URL=https://your-frontend.example.com

# Cloudflare Workers 后台配置
# SHERLLY_API_TOKEN 需要通过 `npm run cf:secret:token` 写入 Cloudflare Secret。
# TURNSTILE_SECRET_KEY 需要通过 `npx wrangler secret put TURNSTILE_SECRET_KEY` 写入 Cloudflare Secret。
# GOOGLE_OAUTH_CLIENT_SECRET、GOOGLE_OAUTH_STATE_SECRET、GOOGLE_OAUTH_TOKEN_KEY 需要通过 Wrangler Secret 写入，不能提交到仓库。
# TURNSTILE_EXPECTED_HOSTNAME、CORS_ORIGIN 和 WORKERS_AI_MODEL 已在 wrangler.jsonc 预留变量，生产环境必须替换为真实值。
# 部署前需创建 `sherlly-attachments` 与 `sherlly-attachments-preview` R2 bucket，名称需与 wrangler.jsonc 一致。
# 部署后把 VITE_SHERLLY_API_URL 改成 Worker 域名，例如：
# VITE_SHERLLY_API_URL=https://sherlly-server.<你的账号>.workers.dev
