{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sherlly-server",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-06-03",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SHERLLY_DATA",
      "id": "e83c28a6cf1447e7bfded9d305abde59",
      "preview_id": "9c1008fa9494495a87bb2394b64fbee3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SHERLLY_AUTH_STORE",
        "class_name": "SherllyAuthStore"
      },
      {
        "name": "SHERLLY_USER_DATA",
        "class_name": "SherllyUserData"
      }
    ]
  },
  // R2 尚未在当前 Cloudflare 账号启用（Dashboard → R2 开通并创建 bucket 后，恢复以下绑定并重新部署）。
  // worker.js 对缺失绑定有降级处理：云附件接口返回“云附件暂未启用”。
  // "r2_buckets": [
  //   {
  //     "binding": "SHERLLY_ATTACHMENTS",
  //     "bucket_name": "sherlly-attachments",
  //     "preview_bucket_name": "sherlly-attachments-preview"
  //   }
  // ],
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "v1-auth-store",
      "new_sqlite_classes": [
        "SherllyAuthStore"
      ]
    },
    {
      "tag": "v2-user-data-store",
      "new_sqlite_classes": [
        "SherllyUserData"
      ]
    }
  ],
  "vars": {
    "SHERLLY_SESSION_TTL_DAYS": "30",
    "CORS_ORIGIN": "https://sherllyzhao.github.io,http://localhost:5188,http://127.0.0.1:5188",
    "TURNSTILE_EXPECTED_HOSTNAME": "",
    "WORKERS_AI_MODEL": "",
    "GOOGLE_OAUTH_CLIENT_ID": "",
    "GOOGLE_OAUTH_REDIRECT_URI": "",
    "GOOGLE_OAUTH_SUCCESS_URL": ""
  }
}
